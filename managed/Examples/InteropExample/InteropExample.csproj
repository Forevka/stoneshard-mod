<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The workflow CoreLoader is built for: run the game once with CoreLoader
    installed, and it writes CoreLoader\Interop\<Game>.Interop\ - a project with
    typed refs to the game's scripts, objects, builtins and assets.

    This mod is written against Dwarf Eats Mountain's. It is found through
    managed\CoreLoader.user.props (run tools\setup-dev.ps1 once, or copy
    CoreLoader.user.props.example), in Visual Studio as with dotnet build -
    see managed\Directory.Build.targets. An explicit
    -p:InteropProject=<path to the .Interop.csproj> still wins.

    The interop dll is copied next to the mod (ship both in Mods\).
  -->
  <PropertyGroup>
    <AssemblyName>InteropExample</AssemblyName>
    <OutputPath>$(ManagedOutRoot)Examples\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <InteropGame>Dwarf_Eats_Mountain</InteropGame>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CoreLoader\CoreLoader.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
