<Project>
  <!--
    Copy to CoreLoader.user.props (ignored by git), or let tools\setup-dev.ps1
    write it. List the folders of games with CoreLoader installed and run at
    least once - that run is what generates CoreLoader\Interop\ there.
    Separate several with ';'.
  -->
  <PropertyGroup>
    <CoreLoaderGameDirs>D:\SteamLibrary\steamapps\common\Dwarf Eats Mountain Demo;D:\Games\Stoneshard</CoreLoaderGameDirs>
  </PropertyGroup>
</Project>
