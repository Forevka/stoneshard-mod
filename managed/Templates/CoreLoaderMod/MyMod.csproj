<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyMod</AssemblyName>
    <RootNamespace>MyMod</RootNamespace>

    <!-- The game this mod is developed against. CoreLoader.dll is referenced
         from its CoreLoader folder, and every build is copied into its Mods
         folder (turn off with -p:DeployOnBuild=false). -->
    <GameDir>GAME_DIR_PLACEHOLDER</GameDir>
    <CoreLoaderDir>$(GameDir)\CoreLoader</CoreLoaderDir>
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">true</DeployOnBuild>

    <!-- A mod is a plugin: NuGet dependencies are copied next to it so they
         deploy with it. CoreLoader itself is supplied by the loader at
         runtime (Private=false below), so it is never shipped. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CoreLoader">
      <HintPath>$(CoreLoaderDir)\CoreLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Compile-time lifetime checks (CL0001-CL0003), installed with CoreLoader.
         The compiler loads it; it is never deployed or loaded by the game. -->
    <Analyzer Include="$(CoreLoaderDir)\Analyzers\CoreLoader.Analyzers.dll" Condition="Exists('$(CoreLoaderDir)\Analyzers\CoreLoader.Analyzers.dll')" />
  </ItemGroup>

<!--#if (hasInterop) -->
  <!-- The typed code map CoreLoader generated for this game on its first run. -->
  <ItemGroup>
    <ProjectReference Include="$(CoreLoaderDir)\Interop\INTEROP_PLACEHOLDER.Interop\INTEROP_PLACEHOLDER.Interop.csproj" />
  </ItemGroup>
<!--#endif -->

  <!-- Content (sprites, sounds) in content/ ships as Mods/MyMod/..., where
       Content.AddSprite("x.png") and friends look for it. -->
  <ItemGroup>
    <None Include="content\**" Link="MyMod\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' And Exists('$(GameDir)')">
    <ItemGroup>
      <ModFiles Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
      <!-- Dependencies built next to the mod (the interop dll, NuGet packages). -->
      <ModFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)CoreLoader.dll" />
    </ItemGroup>
    <ItemGroup>
      <ModContent Include="$(TargetDir)MyMod\**" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(GameDir)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModContent)" DestinationFolder="$(GameDir)\Mods\MyMod\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="MyMod -> $(GameDir)\Mods (hot reload picks it up in a running game)" />
  </Target>

</Project>
