<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every project under Mods/ is a mod: built into bin/<Config>/Mods and
       compiled against CoreLoader without shipping a copy of it. -->
  <PropertyGroup>
    <OutputPath>$(ManagedOutRoot)Mods\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\CoreLoader\CoreLoader.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Compile-time lifetime and game-declaration checks (CL0001-CL0005); never loaded by the game. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\CoreLoader.Analyzers\CoreLoader.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
