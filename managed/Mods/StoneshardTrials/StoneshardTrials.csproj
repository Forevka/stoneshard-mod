<Project Sdk="Microsoft.NET.Sdk">

  <!-- Written against Stoneshard's generated interop, like Reliquary. -->
  <PropertyGroup>
    <AssemblyName>StoneshardTrials</AssemblyName>
    <InteropGame>StoneShard</InteropGame>
  </PropertyGroup>

  <!-- The intro's pictures ship in Mods/StoneshardTrials/Intro/slides (Intro\make_placeholders.py makes the stand-ins). -->
  <ItemGroup>
    <None Include="Intro\slides\*.png" Link="StoneshardTrials\Intro\slides\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
