<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Everything lands in one tree that mirrors the game folder layout:
         bin/<Config>/CoreLoader/... and bin/<Config>/Mods/... -->
    <ManagedOutRoot>$(MSBuildThisFileDirectory)bin\$(Configuration)\</ManagedOutRoot>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Per-developer settings, not in git: where CoreLoader is installed on
       this machine (CoreLoaderGameDirs), so projects that use a game's
       generated interop find it - in Visual Studio as on the command line.
       Written by tools\setup-dev.ps1; see CoreLoader.user.props.example. -->
  <Import Project="$(MSBuildThisFileDirectory)CoreLoader.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)CoreLoader.user.props')" />
  <PropertyGroup>
    <!-- Or from the environment, e.g. on a build machine. -->
    <CoreLoaderGameDirs Condition="'$(CoreLoaderGameDirs)' == ''">$(CORELOADER_GAME_DIRS)</CoreLoaderGameDirs>
  </PropertyGroup>
</Project>
