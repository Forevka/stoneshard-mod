<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- These are mods too: they get the same compile-time lifetime checks
       (CL0001-CL0003) as managed\Mods. Compile time only; never loaded by the game. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\CoreLoader.Analyzers\CoreLoader.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
