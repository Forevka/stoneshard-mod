; Maps the genuine version.dll export names onto our Proxy_* implementations.
; Using aliases here avoids the dllimport/dllexport redefinition conflict that
; would occur if we tried to redefine these names directly against <winver.h>.
;
; All 15 exports of the real C:\Windows\System32\version.dll are covered so that
; any other DLL in the process (Steamworks, the Steam emulator, comctl32, ...)
; still resolves correctly, not just the 3 that StoneShard.exe itself imports.

EXPORTS
    GetFileVersionInfoA         = Proxy_GetFileVersionInfoA
    GetFileVersionInfoByHandle  = Proxy_GetFileVersionInfoByHandle
    GetFileVersionInfoExA       = Proxy_GetFileVersionInfoExA
    GetFileVersionInfoExW       = Proxy_GetFileVersionInfoExW
    GetFileVersionInfoSizeA     = Proxy_GetFileVersionInfoSizeA
    GetFileVersionInfoSizeExA   = Proxy_GetFileVersionInfoSizeExA
    GetFileVersionInfoSizeExW   = Proxy_GetFileVersionInfoSizeExW
    GetFileVersionInfoSizeW     = Proxy_GetFileVersionInfoSizeW
    GetFileVersionInfoW         = Proxy_GetFileVersionInfoW
    VerFindFileA                = Proxy_VerFindFileA
    VerFindFileW                = Proxy_VerFindFileW
    VerInstallFileA             = Proxy_VerInstallFileA
    VerInstallFileW             = Proxy_VerInstallFileW
    VerQueryValueA              = Proxy_VerQueryValueA
    VerQueryValueW              = Proxy_VerQueryValueW

; Loaded-as-a-GameMaker-extension route (tools/data-extension): the game's own
; extension loader resolves this symbol at start-up, which makes it LoadLibrary
; us. See src/extension_entry.cpp. Harmless on the version.dll proxy route.
    coreloader_extension_probe
