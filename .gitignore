# Build output and fetched third-party sources (ImGui, MinHook)
build/
_deps/
# Release zips from tools/package-release.ps1
dist/

# Runtime artifacts the mod writes into its own workspace
*.log
imgui.ini
# Per-process CORELOADER_DATA_DIR roots from test runs
run/
# Save backups made by the legacy native tools; player data, never commit it
save-backups/

# OMC operational state, and Python caches from tools/re
.omc/
__pycache__/
*.pyc
# Derived RE caches, one folder per game (tools/re/cache/<exe stem>/). relib.py
# rebuilds all of these from the game's exe and data.win on demand, and
# call_idx.npy alone is 29 MB - they are build output, not source. The lines
# after it cover caches written beside the tools before they moved per game.
tools/re/cache/
tools/re/*.npy
tools/re/script_table.json
tools/re/objt_indexed.json
tools/re/builtin_table.json

# .NET build output (managed/bin mirrors the game folder layout)
managed/bin/
managed/**/obj/
.vs/
# Per-developer: where games are installed, and the solution that includes
# their generated interop (tools/setup-dev.ps1 writes both)
managed/CoreLoader.user.props
managed/CoreLoader.Dev.sln
managed/CoreLoader.Dev.slnx

# local code index
.codegraph/

# Documentation site (docs-site/build is covered by build/ above)
node_modules/
docs-site/.docusaurus/

# The Trials intro's pictures are not kept in git: put intro_1.jpg ... intro_6.jpg here before building.
managed/Mods/StoneshardTrials/Intro/slides/
