# Build output and fetched third-party sources (ImGui, MinHook)
build/
_deps/

# Runtime artifacts the mod writes into its own workspace
*.log
imgui.ini
debug-cmd.txt
debug-reply.txt

# Copies of the player's save data, taken before the first cheat
save-backups/

# Per-process mod data dirs (SSMOD_DATA_DIR)
run/

# OMC operational state, and Python caches from tools/re
.omc/
__pycache__/
*.pyc
# Derived RE caches. relib.py rebuilds all of these from StoneShard.exe and
# data.win on demand, and call_idx.npy alone is 29 MB - they are build output,
# not source.
tools/re/*.npy
tools/re/script_table.json
tools/re/objt_indexed.json
tools/re/builtin_table.json

# .NET build output (managed/bin mirrors the game folder layout)
managed/bin/
managed/**/obj/
.vs/
